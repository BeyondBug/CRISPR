# PostgreSQL
POSTGRES_DB=crispr
POSTGRES_USER=crispr_app
POSTGRES_PASSWORD=
DB_CONNECT_TIMEOUT_SECONDS=3

# Authentication (password with 12 character)
AUTH_SECRET=
SECURITY_ADMIN_EMAIL=security-admin@example.com
SECURITY_ADMIN_PASSWORD=
SIH_EXECUTIVE_EMAIL=executive@crispr.demo
SIH_EXECUTIVE_PASSWORD=
SIH_TECHNICAL_EMAIL=technical@crispr.demo
SIH_TECHNICAL_PASSWORD=

CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:3000,http://localhost:3000
API_DOCS_ENABLED=false
# live: only persisted connector data may enter calculations; demo: allow fixtures
CRISPR_DATA_MODE=live
NEO4J_ENABLED=true
NEO4J_USER=neo4j
NEO4J_PASSWORD=replace-with-a-long-random-password
DEMO_AUTO_SEED=false
ACCESS_TOKEN_LIFETIME_MINUTES=30
ALLOW_PUBLIC_REPORTER_REGISTRATION=false
# Generate with: python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
INTEGRATION_ENCRYPTION_KEY=
# Keep false in production. Enable only for isolated HTTP test endpoints.
ALLOW_INSECURE_CONNECTOR_HTTP=false

# NVD CVE API 2.0 (request a key from NIST for production rate limits)
NVD_API_KEY=
NVD_USER_AGENT=CRISPR-risk-platform/1.0 security-admin@example.com
# Leave blank to select 0.7s with a key or 6s without one.
NVD_REQUEST_INTERVAL_SECONDS=

# AI Risk Advisor.
LLM_ENABLED=false
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=inclusionai/ling-3.0-flash-sante:free
LLM_API_KEY=

# Optional OpenRouter backup after the primary LLM provider fails.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=inclusionai/ling-3.0-flash-sante:free
